<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>rebuild.preflight-failed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@checks@</string>
		<key>checks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld check failed</string>
			<key>other</key>
			<string>%ld checks failed</string>
		</dict>
	</dict>
	<key>remove.still-running</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>“%1$@” did not quit within %2$#@seconds@. Quit it and try again — nothing was deleted.</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$ld second</string>
			<key>other</key>
			<string>%2$ld seconds</string>
		</dict>
	</dict>
</dict>
</plist>
